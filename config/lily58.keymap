#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define MO_TOG(layer) &mo_tog layer layer   // Macro to apply momentary-layer-on-hold/toggle-layer-on-tap to a specific layer

// TODO - Custom rename for long names
// TODO - Wake from Deep Sleep
// DONE - Double Grave
// DONE - Change Lily58 Minus - to second layer
// DONE - Change Lily58 Backslash - to second layer
// DONE - Get rid of gresc
// DONE - Test Lily58 soft off
// DONE - Change Lily58 left hand left-most thumb cluster key
// DONE - Add Lily58 Show all apps
// DONE - Change Lily58 Backspace - BSPC vs BSPCDEL & Location
// DONE - Change Lily58 arrows
// DONE - Change Lily58 Escape
// DONE - Change Lily58 left hand Tab

/ {
    behaviors {
        // Rename C_AC_DESKTOP_SHOW_ALL_APPLICATIONS
            LPad: launch_pad {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS>, <&kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS>;
                mods = <(MOD_LGUI)>;
            };
        // Rename C_AC_DESKTOP_SHOW_ALL_WINDOWS
            Mssn: mission_control {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS>, <&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth 0
            Bth0: bluetooth_0 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&bt BT_SEL 0>, <&bt BT_SEL 0>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth 1
            Bth1: bluetooth_1 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&bt BT_SEL 1>, <&bt BT_SEL 1>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth 2
            Bth2: bluetooth_2 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&bt BT_SEL 2>, <&bt BT_SEL 2>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth 3
            Bth3: bluetooth_3 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&bt BT_SEL 3>, <&bt BT_SEL 3>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth 4
            Bth4: bluetooth_4 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&bt BT_SEL 4>, <&bt BT_SEL 4>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Dim
            Dim: brightness_down {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_BRI_DN>, <&kp C_BRI_DN>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bright
            Brgt: brightness_up {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_BRI_UP>, <&kp C_BRI_UP>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Previous
            Prev: previous {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_PREV>, <&kp C_PREV>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Play Pause
            Play: play_pause {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_PP>, <&kp C_PP>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Next
            Next: next {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_NEXT>, <&kp C_NEXT>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Mute
            Mute: mute {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_MUTE>, <&kp C_MUTE>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Volume Down
            VDwn: volume_down {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_VOL_DN>, <&kp C_VOL_DN>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Volume Up
            VUp: volume_up {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp C_VOL_UP>, <&kp C_VOL_UP>;
                mods = <(MOD_LGUI)>;
            };
        // Rename USB Out
            OUsb: output_usb {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&out OUT_USB>, <&out OUT_USB>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth Out
            OBth: output_bluetooth {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&out OUT_BLE>, <&out OUT_BLE>;
                mods = <(MOD_LGUI)>;
            };
        // Rename Bluetooth Clear
            BtCl: bluetooth_clear {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&bt BT_CLR>, <&bt BT_CLR>;
                mods = <(MOD_LGUI)>;
            };
        // CMD + BACKSPACE = DELETE
            bsdel: backspace_del {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp BACKSPACE>, <&kp DELETE>;
                mods = <(MOD_LGUI)>;
            };
        // CMD + GRAVE = ESCAPE
            gresc: grave_escape {
                compatible = "zmk,behavior-mod-morph";
                label = "GRAVE_ESCAPE";
                #binding-cells = <0>;
                bindings = <&kp GRAVE>, <&kp ESC>;
                mods = <(MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // 
                // +--------+--------+--------+--------+--------+--------+                        +--------+--------+--------+--------+--------+--------+
                // |   `    |   1    |   2    |   3    |   4    |   5    |                        |   6    |   7    |   8    |   9    |   0    |   =    |
                // +--------+--------+--------+--------+--------+--------+                        +--------+--------+--------+--------+--------+--------+
                // |   `    |   Q    |   W    |   E    |   R    |   T    |                        |   Y    |   U    |   I    |   O    |   P    |  BSPC  |
                // +--------+--------+--------+--------+--------+--------+                        +--------+--------+--------+--------+--------+--------+
                // | TAB    |   A    |   S    |   D    |   F    |   G    |                        |   H    |   J    |   K    |   L    |   ;    |   '    |
                // +--------+--------+--------+--------+--------+--------+--------+      +--------+--------+--------+--------+--------+--------+--------+
                // | SHIFT  |        |   Z    |   X    |   C    |   V    |        |      |        |   B    |   N    |   M    |   ,    |   .    |   /    |
                // +--------+--------+--------+--------+--------+--------+--------+      +--------+--------+--------+--------+--------+--------+--------+
                //                            |        |  CTRL  |  OPT   |  CMD   |      | SPACE  | ENTER  | LAYER  |        |
                //                            +--------+--------+--------+--------+      +--------+--------+--------+--------+

            bindings = <
                &kp GRAVE &kp N1   &kp N2   &kp N3    &kp N4    &kp N5                             &kp N6      &kp N7      &kp N8    &kp N9    &kp N0   &kp EQUAL
                &kp GRAVE &kp Q    &kp W    &kp E     &kp R     &kp T                              &kp Y       &kp U       &kp I     &kp O     &kp P    &kp BSPC
                &kp TAB   &kp A    &kp S    &kp D     &kp F     &kp G                              &kp H       &kp J       &kp K     &kp L     &kp SEMI &kp SQT
                &kp LSHFT &none    &kp Z    &kp X     &kp C     &kp V    &none          &none      &kp B       &kp N       &kp M     &kp COMMA &kp DOT  &kp FSLH 
                                            &none     &kp LCTRL &kp LALT &kp LGUI       &kp SPACE  &kp RET     &mo 1       &none
            >;
        };

        lower_layer {
            //
                // +--------+--------+--------+--------+--------+--------+                        +--------+--------+--------+--------+--------+--------+
                // |  DIM   | BRIGHT | WINDOW |        |   F4   |   F5   |                        |  BACK  |  PLAY  |  NEXT  |  MUTE  | V DOWN |  V UP  |
                // +--------+--------+--------+--------+--------+--------+                        +--------+--------+--------+--------+--------+--------+
                // | ESC    |  BT1   |  BT2   |  BT3   |  BT4   |  BT5   |                        | SFTOFF |        |        |        |        |   -    |
                // +--------+--------+--------+--------+--------+--------+                        +--------+--------+--------+--------+--------+--------+
                // | TAB    |  USB   |  BLE   |  CLR   |        |    [   |                        |   ]    |  HOME  |   ^    |  END   | PG UP  |        |
                // +--------+--------+--------+--------+--------+--------+--------+      +--------+--------+--------+--------+--------+--------+--------+
                // | SHIFT  |        |        |        |        |        |        |      |        |        |   <-   |   v    |  ->    | PG DN  |   \    |
                // +--------+--------+--------+--------+--------+--------+--------+      +--------+--------+--------+--------+--------+--------+--------+
                //                            |        |  CTRL  |  OPT   |  CMD   |      | SPACE  | ENTER  |        |        |
                //                            +--------+--------+--------+--------+      +--------+--------+--------+--------+

            bindings = <
                    &Dim      &Brgt   &Mssn    &none    &kp F4   &kp F5                            &Prev     &Play    &Next    &Mute     &VDwn     &VUp
                    &kp ESC   &Bth0   &Bth1    &Bth2    &Bth3    &Bth4                             &soft_off &none    &none    &none     &none     &kp MINUS 
                    &kp TAB   &OUsb   &OBth    &BtCl    &none    &kp LBKT                          &kp RBKT  &kp HOME &kp UP   &kp END   &kp PG_UP &none 
                    &kp LSHFT &none   &none    &none    &none    &none    &none          &none     &none     &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &kp BSLH 
                                                        &none    &kp RALT &kp LGUI       &kp SPACE &kp RET   &none    &none    &none
            >;
        };
    };
};